#: src/gpk-enum.c:463
msgid ""
"There is no network connection available.\n"
"Please check your connection settings and try again."
msgstr ""
"Inga nettverkstilkopling tilgjengeleg.\n"
"Kontroller tilkoplingsinnstillingane og prøv på nytt."

#: src/gpk-enum.c:467
msgid ""
"The package list needs to be rebuilt.\n"
"This should have been done by the backend automatically."
msgstr ""
"Pakkelista må byggjast på nytt.\n"
"Bakstykket skulle gjort dette automatisk."

#: src/gpk-enum.c:471
msgid ""
"The service that is responsible for handling user requests is out of "
"memory.\n"
"Please restart your computer."
msgstr ""
"Tenesta som handterer brukarførespurnader er tom for minne.\n"
"Start datamaskina på nytt."

#: src/gpk-enum.c:475
msgid "A thread could not be created to service the user request."
msgstr "Klarte ikkje lage tråd for å handtere brukarførespurnaden."

#: src/gpk-enum.c:478
#| msgid ""
#| "The action is not supported by this backend.\n"
#| "Please report a bug in your distribution bugtracker as this should not "
#| "have happened."
msgid ""
"The action is not supported by this backend.\n"
"Please report a bug in your distribution bug tracker as this should not have "
"happened."
msgstr ""
"Handlinga er ikkje støtta av dette bakstykket.\n"
"Rapporter feilen i feilsporaren til distribusjonen, sidan dette ikkje skulle ha skjedd."

#: src/gpk-enum.c:482
#| msgid ""
#| "A problem that we were not expecting has occurred.\n"
#| "Please report this bug in your distribution bugtracker with the error "
#| "description."
msgid ""
"A problem that we were not expecting has occurred.\n"
"Please report this bug in your distribution bug tracker with the error "
"description."
msgstr ""
"Eit uventa problem har oppstått.\n"
"Rapporter feilen i feilsporaren til distribusjonen, med feilskildringa."

#: src/gpk-enum.c:486
#| msgid ""
#| "A security trust relationship could not be made with software source.\n"
#| "Please check your security settings."
msgid ""
"A security trust relationship could not be made with package source.\n"
"Please check your security settings."
msgstr ""
"Klarte ikkje opprette eit tillitsforhold til pakkekjelda.\n"
"Kontroller tryggleiksinnstillingane."

#: src/gpk-enum.c:490
msgid ""
"The package that is trying to be removed or updated is not already installed."
msgstr "Pakken som prøver å verte fjerna eller oppdatert er ikkje installert."

#: src/gpk-enum.c:493
#| msgid ""
#| "The package that is being modified was not found on your system or in any "
#| "software source."
msgid ""
"The package that is being modified was not found on your system or in any "
"package source."
msgstr ""
"Pakken som vert endra vart ikkje funnen på systemet ditt eller i nokon "
"pakkekjelde."

#: src/gpk-enum.c:496
msgid "The package that is trying to be installed is already installed."
msgstr "Pakken som prøver å verte installert er alt installert."

#: src/gpk-enum.c:499
msgid ""
"The package download failed.\n"
"Please check your network connectivity."
msgstr ""
"Nedlasting av pakke feila.\n"
"Kontroller tilkoplinga til nettverket."

#: src/gpk-enum.c:503
msgid ""
"The group type was not found.\n"
"Please check your group list and try again."
msgstr ""
"Gruppetypen vart ikkje funnen.\n"
"Kontroller gruppelista og prøv på nytt."

#: src/gpk-enum.c:507
msgid ""
"The group list could not be loaded.\n"
"Refreshing your cache may help, although this is normally a software source "
"error."
msgstr ""
"Gruppelista kunne ikkje lastast inn.\n"
"Det kan hjelpe å oppdatere hurtiglagringa, men vanlegvis er dette ein feil i programvarekjelda."

#: src/gpk-enum.c:512
msgid ""
"A package could not be found that allows the action to complete.\n"
"More information is available in the detailed report."
msgstr ""
"Fann ingen pakke som lèt handlinga fullførast.\n"
"Meir informasjon er tilgjengeleg i den detaljerte rapporten."

#: src/gpk-enum.c:516
msgid "The search filter was not correctly formed."
msgstr "Søkjefilteret hadde ikkje riktig form."

#: src/gpk-enum.c:519
msgid ""
"The package identifier was not well formed when sent to the server.\n"
"This normally indicates an internal error and should be reported."
msgstr ""
"Pakkeidentifikatoren hadde ikkje riktig form då han vart send til tenaren.\n"
"Dette tyder normalt på ein intern feil og bør rapporterast."

#: src/gpk-enum.c:523
msgid ""
"An unspecified transaction error has occurred.\n"
"More information is available in the detailed report."
msgstr ""
"Det har oppstått ein uspesifisert transaksjonsfeil.\n"
"Meir informasjon er tilgjengeleg i den detaljerte rapporten."

#: src/gpk-enum.c:527
#| msgid ""
#| "The remote software source name was not found.\n"
#| "You may need to enable an item in Software Sources."
msgid ""
"The remote package source name was not found.\n"
"You may need to enable an item in Package Sources."
msgstr ""
"Namnet på den eksterne pakkekjelda vart ikkje funne.\n"
"Du må kanskje slå på noko under «Pakkekjelder»."

#: src/gpk-enum.c:531
msgid "Removing a protected system package is not allowed."
msgstr "Det er ikkje tillate å fjerne verna systempakkar."

#: src/gpk-enum.c:534
msgid "The action was canceled successfully and no packages were changed."
msgstr "Handlinga vart avbroten, og ingen pakkar vart endra."

#: src/gpk-enum.c:537
msgid ""
"The action was canceled successfully and no packages were changed.\n"
"The backend did not exit cleanly."
msgstr ""
"Handlinga vart avbroten, og ingen pakkar vart endra.\n"
"Bakstykket avslutta ikkje reint."

#: src/gpk-enum.c:541
msgid ""
"The native package configuration file could not be opened.\n"
"Please make sure configuration is valid."
msgstr ""
"Oppsettsfila til det innfødde pakkesystemet kunne ikkje opnast.\n"
"Sjå til at oppsettet er gyldig."

#: src/gpk-enum.c:545
msgid "The action cannot be canceled at this time."
msgstr "Handlinga kan ikkje avbrytast no."

#: src/gpk-enum.c:548
msgid ""
"Source packages are not normally installed this way.\n"
"Check the extension of the file you are trying to install."
msgstr ""
"Kjeldepakkar vert normalt ikkje installerte på denne måten.\n"
"Kontroller filtypen på fila du prøver å installere."

#: src/gpk-enum.c:552
msgid ""
"The license agreement was not agreed to.\n"
"To use this software you have to accept the license."
msgstr ""
"Lisensvilkåra vart ikkje godtekne.\n"
"For å bruke denne programvara må du godta lisensvilkåra."

#: src/gpk-enum.c:556
#| msgid ""
#| "Two packages provide the same file.\n"
#| "This is usually due to mixing packages from different software sources."
msgid ""
"Two packages provide the same file.\n"
"This is usually due to mixing packages from different sources."
msgstr ""
"To pakkar inneheld den same fila.\n"
"Dette skuldast som regel at pakkar frå ulike kjelder er blanda."

#: src/gpk-enum.c:560
#| msgid ""
#| "Multiple packages exist that are not compatible with each other.\n"
#| "This is usually due to mixing packages from different software sources."
msgid ""
"Multiple packages exist that are not compatible with each other.\n"
"This is usually due to mixing packages from different sources."
msgstr ""
"Det finst fleire pakkar som ikkje er kompatible med kvarandre.\n"
"Dette skuldast som regel at pakkar frå ulike kjelder er blanda."

#: src/gpk-enum.c:564
#| msgid ""
#| "There was a (possibly temporary) problem connecting to a software "
#| "source.\n"
#| "Please check the detailed error for further details."
msgid ""
"There was a (possibly temporary) problem connecting to a package source.\n"
"Please check the detailed error for further details."
msgstr ""
"Det oppstod eit (moglegvis mellombels) problem med å kople seg til ei pakkekjelde.\n"
"Sjå den detaljerte feilmeldinga for meir informasjon."

#: src/gpk-enum.c:568
msgid ""
"Failed to initialize packaging backend.\n"
"This may occur if other packaging tools are being used simultaneously."
msgstr ""
"Oppstart av pakkebakstykket feila.\n"
"Dette kan hende når andre pakkeverktøy vert brukte samtidig."

#: src/gpk-enum.c:572
msgid ""
"Failed to close down the backend instance.\n"
"This error can normally be ignored."
msgstr ""
"Lukking av bakstykkeinstansen feila.\n"
"Denne feilen kan normalt sett ignorerast."

#: src/gpk-enum.c:576
msgid ""
"Cannot get the exclusive lock on the packaging backend.\n"
"Please close any other legacy packaging tools that may be open."
msgstr ""
"Klarte ikkje få eksklusiv lås på pakkebakstykket.\n"
"Lukk eventuelle andre eldre pakkeverktøy som er opne."

#: src/gpk-enum.c:580
msgid "None of the selected packages could be updated."
msgstr "Ingen av dei valde pakkane kunne oppdaterast."

#: src/gpk-enum.c:583
msgid "The repository configuration could not be modified."
msgstr "Oppsettet for pakkekjelder kunne ikkje endrast."

#: src/gpk-enum.c:586
msgid ""
"Installing the local file failed.\n"
"More information is available in the detailed report."
msgstr ""
